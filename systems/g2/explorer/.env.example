# ============================================================
# Environment Configuration
# ============================================================
# Model profiles (THESIS_MODEL_PROFILE) set all model-specific
# parameters automatically. The env vars below can override them.
#
# Quick start:
#   1. Set THESIS_MODEL_PROFILE (7b / 14b / 32b / 72b)
#   2. Set THESIS_LLM_API_BASE to your vLLM ngrok URL
#   3. ./scripts/run_single.sh hello-world
# ============================================================

THESIS_LLM_API_BASE=https://<your-ngrok-subdomain>.ngrok-free.dev/v1
THESIS_LLM_PROVIDER=vllm

THESIS_MODEL_PROFILE=32b

# --- Override profile defaults (optional) ---
# These override the values from the model profile.
# Leave commented to use profile defaults.
# THESIS_LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ
# THESIS_LLM_MAX_TOKENS=2048
# THESIS_LLM_TEMPERATURE=0.0
# THESIS_LLM_TOOL_CALLING=prompt
# THESIS_LLM_TIMEOUT — driven by model profile (default 300s). Uncomment to override.
# THESIS_LLM_TIMEOUT=300

# --- Agent Budgets (optional overrides) ---
# Leave commented to use profile defaults.
# THESIS_AGENT_MAX_STEPS=60
# THESIS_AGENT_MAX_WALLCLOCK=600
# THESIS_AGENT_MAX_OUTPUT=16000
# THESIS_AGENT_MAX_CONTEXT_TOKENS=28000

THESIS_AGENT_EXPLORER_MAX_STEPS=5
THESIS_AGENT_EXPLORER_MAX_WALLCLOCK=90

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR
THESIS_LOG_LEVEL=INFO



